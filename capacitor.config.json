{
  "appId": "com.mediplanner.app",
  "appName": "MediPlanner",
  "webDir": ".",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "CapacitorSQLite": {
      "iosDatabaseLocation": "Library/CapacitorDatabase",
      "iosIsEncryption": false,
      "androidIsEncryption": false
    },
    "BackgroundRunner": {
      "label": "com.mediplanner.app.sync",
      "src": "sw.js",
      "event": "syncQueue",
      "repeat": true,
      "interval": 15,
      "autoStart": true
    }
  }
}